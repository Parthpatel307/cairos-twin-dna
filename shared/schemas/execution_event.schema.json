{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAIROS TWIN DNA Execution Event",
  "description": "Observable execution event recorded during an AI agent run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "run_id",
    "sequence",
    "timestamp",
    "event_type",
    "actor"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "user_request",
        "plan_created",
        "decision",
        "tool_call",
        "tool_response",
        "state_change",
        "memory_change",
        "permission_check",
        "simulation",
        "risk_analysis",
        "execution",
        "error",
        "result"
      ]
    },
    "actor": {
      "type": "string",
      "enum": [
        "user",
        "agent",
        "tool",
        "system"
      ]
    },
    "action": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool": {
      "type": [
        "string",
        "null"
      ]
    },
    "input": {
      "type": [
        "object",
        "null"
      ]
    },
    "output": {
      "type": [
        "object",
        "null"
      ]
    },
    "state_before": {
      "type": [
        "object",
        "null"
      ]
    },
    "state_after": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ]
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}